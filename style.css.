
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f5f5f5;
    color: #333;
}

header {
    background-color: #3949ab;
    color: white;
    text-align: center;
    padding: 50px 20px;
}

nav {
    background-color: #283593;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}

nav a:hover {
    text-decoration: underline;
}

section {
    background-color: white;
    margin: 25px auto;
    padding: 25px;
    max-width: 800px;
    border-radius: 10px;
    box-shadow: 0 2px 8px #ddd;
}

h2 {
    color: #3949ab;
}

li {
    margin: 10px 0;
}

footer {
    background-color: #283593;
    color: white;
    text-align: center;
    padding: 20px;
}

